BOT_TOKEN=
CLIENT_ID=
GUILD_ID=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Channel where partner application admin embed cards get posted
ADMIN_CHANNEL_ID=

# ─── Partner roles (assigned by bot on form approval) ─────────────────────────
# These map to dynamic-form `settings.role_id` on each form.
ROLE_BAR=
ROLE_CLUB=
ROLE_ARTIST=
ROLE_CREATOR=

# ─── Public / reward roles (roles brief) ──────────────────────────────────────
# Auto-assigned to every new member on join
ROLE_FAN=
# Assigned by bot when a member submits a store request
ROLE_SCOUT=
# Assigned via /legend slash command (admins only)
ROLE_LEGEND=

# ─── Store request flow ───────────────────────────────────────────────────────
# Public channel where the persistent "Request a Store" embed lives
STORE_REQUEST_CHANNEL_ID=
# Internal channel where new store request submissions get posted as embeds
STORE_ADMIN_CHANNEL_ID=

# ─── HTTP API (dashboard ↔ bot) ───────────────────────────────────────────────
BOT_API_PORT=3001
BOT_API_SECRET=
