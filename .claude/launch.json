{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Dashboard (Next.js)",
      "runtimeExecutable": "/bin/bash",
      "runtimeArgs": ["-c", "export PATH=/opt/homebrew/bin:$PATH && cd dashboard && npm run dev"],
      "port": 3000
    },
    {
      "name": "Bot (Discord + Express API)",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "index.js"],
      "port": 3001,
      "cwd": "bot"
    }
  ]
}
